# Sesame Gateway Configuration

# Enterprise AI backend URL
ENTERPRISE_AI_URL=https://agents.gree.com

# AES-256-GCM encryption key (32 bytes, base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Database URL (SQLite for dev, MySQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/sesame.db
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/sesame

# Cookie validation on submit (true/false)
VALIDATE_COOKIE_ON_SUBMIT=true
# Override URL for cookie validation (empty = use ENTERPRISE_AI_URL)
# VALIDATE_COOKIE_URL=https://agents.gree.com/agents/baitong/chat/completions

# Default cookie expiration in days
DEFAULT_COOKIE_EXPIRE_DAYS=7

# Auto-created admin user (created on first startup)
# IMPORTANT: You MUST set ADMIN_PASSWORD for production use
ADMIN_USER=admin
ADMIN_PASSWORD=

# Default proxy routes (JSON array, created on first startup if not exist)
# DEFAULT_ROUTES=[{"path":"/v1/chat/completions","backend_path":"/agents/baitong/chat/completions","method":"POST","is_streamable":true,"description":"Chat Completions"},{"path":"/v1/images/generations","backend_path":"/agents/baitong/images/generations","method":"POST","is_streamable":false,"description":"Image Generation"}]
