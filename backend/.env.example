# Sesame Gateway Configuration

# Enterprise AI backend URL
ENTERPRISE_AI_URL=https://agents.gree.com

# AES-256-GCM encryption key (32 bytes, base64 encoded)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sesame
MYSQL_PASSWORD=
MYSQL_DATABASE=sesame

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cookie validation on submit (true/false)
VALIDATE_COOKIE_ON_SUBMIT=true

# Default cookie expiration in days
DEFAULT_COOKIE_EXPIRE_DAYS=7

# Auto-created admin user (created on first startup)
# IMPORTANT: You MUST set ADMIN_PASSWORD for production use
ADMIN_USER=admin
ADMIN_PASSWORD=
